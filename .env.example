# TrustBridge (ClearPay) — example environment file.
# Copy to `.env` and fill in. NEVER commit a real `.env`.

# --- API auth (demo only, not a real user auth system) ---
API_KEY=trustbridge-demo-key

# --- LLM provider (optional) ---
# With no key configured the app runs in deterministic offline mode,
# so the demo always works. Set a key to use a real provider.
#   LLM_PROVIDER = mock | openai | anthropic   (auto-detected when empty)
LLM_PROVIDER=
LLM_API_KEY=
# LLM_BASE_URL=          # default: https://api.openai.com/v1  or  https://api.anthropic.com
# LLM_MODEL=             # default: gpt-4o-mini (openai) / claude-3-5-haiku-latest (anthropic)
# Aliases also honoured: OPENAI_API_KEY, ANTHROPIC_API_KEY

# --- Server ---
HOST=127.0.0.1
PORT=8765

# --- Storage (SQLite) ---
# DATA_DIR=./data
